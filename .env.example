# Documents required environment variables. Placeholder values only —
# never commit a real DATABASE_URL or any other credential to this file
# or to .env (.env is gitignored).

DATABASE_URL="mysql://user:password@localhost:3306/db"

# JOB-AGT-WEB-20260726-M4.6 — Google ecosystem readiness. Both are optional
# and unset by default: nothing Google-related loads until the owner
# supplies real values (see docs/google-ecosystem-setup.md). Never fill
# these in with placeholder/fake IDs — leave unset until the real
# GTM container / Search Console verification exist.

# GTM-XXXXXXX from a real Google Tag Manager container. GA4 and Google Ads
# conversion tracking are configured as tags inside that container, not as
# separate env vars here.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# The verification code Google Search Console issues for the HTML tag
# method, once the owner verifies the domain.
GOOGLE_SITE_VERIFICATION=
