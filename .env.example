# Documents required environment variables. Placeholder values only —
# never commit a real DATABASE_URL or any other credential to this file
# or to .env (.env is gitignored).

DATABASE_URL="mysql://user:password@localhost:3306/db"
# Local development: docker-compose.yml + .env.docker.example spin up a
# disposable local MySQL container to point this at — see
# 07_WEBSITE/BOOKING_SYSTEM/07_DATABASE_LOCAL_DEVELOPMENT_SETUP.md.

# JOB-AGT-WEB-20260726-M4.6 — Google ecosystem readiness. Both are optional
# and unset by default: nothing Google-related loads until the owner
# supplies real values (see docs/google-ecosystem-setup.md). Never fill
# these in with placeholder/fake IDs.

# GTM-XXXXXXX from a real Google Tag Manager container. GA4 and Google Ads
# conversion tracking are configured as tags inside that container, not as
# separate env vars here. A real container was created and confirmed by the
# Owner on 2026-08-04 (GTM-N93GXMRR) — its value is NOT written here: this
# is a template file checked into git, and this var is NEXT_PUBLIC_ (baked
# into the client bundle at build time), so it must be set directly in the
# production environment (Hostinger hPanel) followed by a real rebuild, not
# in any git-tracked file. Setting it here would have zero effect on the
# deployed site — Next.js never reads .env.example at build or runtime.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# The verification code Google Search Console issues for the HTML tag
# method, once the owner verifies the domain.
GOOGLE_SITE_VERIFICATION=

# Search Engine Ecosystem pass (2026-08-04) — same pattern as
# GOOGLE_SITE_VERIFICATION above: unset by default, renders nothing until
# the owner supplies the real code from each engine's own webmaster tool.
# Never fill these in with placeholder/fake values.

# Bing Webmaster Tools verification code (renders as msvalidate.01).
BING_SITE_VERIFICATION=

# Pinterest Business domain-verification code (renders as p:domain_verify).
PINTEREST_DOMAIN_VERIFICATION=

# Chat widget kill switch (08_DIGITAL_SYSTEMS/AI_CHATBOT/06_WEBSITE_INTEGRATION_PLAN.md).
# Widget is ON by default. Set to "false" and rebuild to pull it from every
# page without a code change. Requires a rebuild either way (NEXT_PUBLIC_ vars
# are baked in at build time), same as every other var on this page.
NEXT_PUBLIC_CHAT_WIDGET_ENABLED=

# Chatbot LLM upgrade (2026-08-06) — set OPENAI_API_KEY to switch the
# chatbot from the rule-based engine (src/lib/chat-mvp/*) to real AI
# answers via src/lib/chat/llm-adapter.ts. Falls back to the rule-based
# flow automatically whenever this is unset.
OPENAI_API_KEY=

# Not used — scaffolded for a possible future Anthropic-backed path
# (src/lib/chat/llm-adapter.ts), inert today. The chatbot uses
# OPENAI_API_KEY above.
ANTHROPIC_API_KEY=

# Official WhatsApp Business Platform (Cloud API) — 2026-08-06. Lets
# customers message the business WhatsApp number directly and get the
# same AI assistant (src/lib/chat/engine.ts) the website chat widget
# uses. Unset by default: the webhook route rejects every request until
# all four are set. See src/app/api/whatsapp/webhook/route.ts's header
# comment for the exact Meta for Developers setup steps to obtain these.
# Never fill these in with placeholder/fake values.

# Permanent token from a System User (Business Settings > System Users)
# with whatsapp_business_messaging permission — not the 24h temporary
# token the API Setup page shows by default.
WHATSAPP_ACCESS_TOKEN=

# From WhatsApp > API Setup in the Meta for Developers app.
WHATSAPP_PHONE_NUMBER_ID=

# App Settings > Basic > App Secret — used to verify that inbound
# webhook requests really came from Meta (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# Any string the Owner makes up — must exactly match the "Verify token"
# typed into WhatsApp > Configuration > Webhook in the Meta app.
WHATSAPP_VERIFY_TOKEN=

# Social-content drafting automation (n8n) — 2026-08-07. Shared secret an
# n8n workflow sends as the x-api-key header when calling
# GET /api/social-content/facts. Read-only (no publishing, no write
# access) — generate a real random value yourself (e.g.
# `openssl rand -hex 24`), never a placeholder. Requests without a
# matching key get 401; the route itself is otherwise inert unset.
SOCIAL_CONTENT_API_KEY=

# Google Login upgrade (07_WEBSITE/IMPLEMENTATION/08_AUTHENTICATION_ARCHITECTURE.md
# §5, §14.3). All three unset by default: "Continue with Google" leads to a
# clear "not configured" response, not a broken flow, until every one of
# these is set. Never fill these in with placeholder/fake values — leave
# unset until the real Google Cloud OAuth app and a real generated secret
# exist. See that document + the final report for the exact Google Cloud
# Console steps required to obtain real values.

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0
# Client ID (Web application). Not secret by itself, but still only ever
# set as a real env var, never hardcoded.
GOOGLE_CLIENT_ID=

# The Client Secret paired with GOOGLE_CLIENT_ID above. A real secret —
# never commit it, never log it, never put it in any document.
GOOGLE_CLIENT_SECRET=

# Signs/verifies the OAuth `state` parameter (CSRF protection + PKCE
# code_verifier carrier — see src/lib/services/oauth-state.ts). Generate a
# long random value yourself (e.g. `openssl rand -base64 32`) — this is
# not issued by Google, it's local to this app. Required before
# /api/auth/google/* will work at all, independent of the two Google
# values above.
AUTH_SECRET=
