// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// PROVISIONAL (M1 Domain Foundation, amended M1.2, M2.3) — mirrors
// src/types/domain.ts, which implements 08_DIGITAL_SYSTEMS/DATA_MODEL.md
// (Status: Approved, v0.2, amended v0.3). These models are still NOT
// migrated against any database — schema-only, validated with
// `npx prisma validate` and nothing else. "Provisional" here means "not yet
// migrated," not "unapproved."
//
// No relations are declared between entities beyond what DATA_MODEL.md
// states explicitly (IDs are references, not enforced foreign keys) — this
// keeps the schema from asserting integrity rules that aren't yet approved.
// Timestamps use Prisma's DateTime; the TS domain contracts (src/types)
// represent the same values as ISO strings at the API boundary.
// ---------------------------------------------------------------------------

/// Provisional — id only, per DATA_MODEL.md ("references the canonical
/// service ID and approved service knowledge"). No other fields are approved.
model Service {
  id String @id
}

/// Provisional — id only, per DATA_MODEL.md ("references approved
/// geographic coverage; it is not a branch").
model ServiceArea {
  id String @id
}

/// Provisional. ContactPoint is a related table here even though the TS
/// contract embeds it as an array on Customer — MySQL/Prisma has no scalar
/// array type, so persistence needs its own row per contact point.
model Customer {
  id            String         @id
  contactPoints ContactPoint[]
}

model ContactPoint {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  channel    ContactChannel
  value      String

  @@index([customerId])
}

enum ContactChannel {
  phone
  whatsapp
  email
}

/// id added in DATA_MODEL.md v0.2 (M1.2) — application-generated, like every
/// other entity's id, not database-generated.
model Consent {
  id         String         @id
  channel    ContactChannel
  purpose    String
  status     ConsentStatus
  source     String
  evidence   String
  recordedAt DateTime
}

enum ConsentStatus {
  granted
  withdrawn
  expired
}

model Enquiry {
  id         String        @id
  customerId String
  need       String
  source     String
  status     EnquiryStatus
}

enum EnquiryStatus {
  new
  in_progress
  resolved
  closed
}

/// customerId added in DATA_MODEL.md v0.3 (M2.3 Customer Ownership Domain
/// Amendment) — a free-form reference, like Enquiry.customerId, not an
/// enforced foreign key (see the note above on relations).
model BookingRequest {
  id                 String               @id
  customerId         String
  serviceId          String
  serviceAreaId      String
  schedulePreference String
  status             BookingRequestStatus
}

enum BookingRequestStatus {
  requested
  confirmed
  rescheduled
  cancelled
}

/// Provisional. `evidence` is Json because MySQL/Prisma has no scalar array
/// type; the TS contract types it as string[] (evidence references, never a
/// resolved price — see DATA_MODEL.md). customerId added in DATA_MODEL.md
/// v0.3 (M2.3 Customer Ownership Domain Amendment) — a free-form reference,
/// like Enquiry.customerId, not an enforced foreign key.
model QuoteRequest {
  id           String @id
  customerId   String
  serviceId    String
  requirements String
  evidence     Json
}

model WorkOrder {
  id               String          @id
  bookingRequestId String
  status           WorkOrderStatus
}

enum WorkOrderStatus {
  created
  scheduled
  completed
  cancelled
}

/// targetType/targetId added in DATA_MODEL.md v0.2 (M1.2) — bind the
/// approval to the exact action instance it authorizes, per the Rules
/// section: "a generically approved record does not satisfy an entity's
/// approval-gated creation rule." targetType is a free string, not an enum:
/// Approval also gates non-domain actions (spend, DNS, credentials) per
/// AUTONOMY_AND_APPROVAL_MATRIX.md, not only domain entities.
model Approval {
  id         String              @id
  action     String
  targetType String
  targetId   String
  riskLevel  ApprovalRiskLevel
  requester  String
  decision   ApprovalDecision
  evidence   String
  expiresAt  DateTime

  @@index([targetType, targetId])
}

enum ApprovalRiskLevel {
  A0
  A1
  A2
  A3
  A4
}

enum ApprovalDecision {
  pending
  approved
  rejected
  expired
}

model Interaction {
  id         String         @id
  channel    ContactChannel
  consentId  String
  occurredAt DateTime
}

model AuditEvent {
  id            String   @id
  actor         String
  action        String
  target        String
  outcome       String
  timestamp     DateTime
  correlationId String
}
