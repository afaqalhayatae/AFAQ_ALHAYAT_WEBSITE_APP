# Template for docker-compose.yml's local-only MySQL container.
# Copy to .env.docker (already gitignored via the repo's .env* rule) and
# fill in local-dev-only values. NEVER put a real/production credential
# here — this container is disposable local development infrastructure
# only, per 07_WEBSITE/BOOKING_SYSTEM/07_DATABASE_LOCAL_DEVELOPMENT_SETUP.md.
#
# After starting the container, build your own DATABASE_URL (in your
# untracked .env, see .env.example for the format) from MYSQL_USER,
# MYSQL_PASSWORD, MYSQL_PORT, and MYSQL_DATABASE below.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=afaq_local_dev
MYSQL_USER=afaq_dev
MYSQL_PASSWORD=
MYSQL_PORT=3306
